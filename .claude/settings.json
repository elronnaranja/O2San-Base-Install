{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "env": {
    "CAVEMAN_DEFAULT_MODE": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard.py 2>/dev/null || python .claude/hooks/guard.py 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
